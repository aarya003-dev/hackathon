# Copy this file to `.env` (which is gitignored) and fill in real values.
#   cp .env.example .env

# ---- Application ----
APP_NAME=Code Review Agent
CORS_ORIGINS=http://localhost:5173

# ---- Ingestion source ----
#   local_git -> watch/push a local repo (no deployment, no port forwarding)
#   webhook   -> GitHub webhook adapter (requires inbound reachability)
INGESTION_SOURCE=local_git
# Shared secret for POST /api/v1/ingest/git (must match the hook/watcher)
INGEST_SECRET=dev-secret
# Same value forwarded by the dashboard's "New Analysis" action
# (Vite exposes VITE_* vars to the frontend; keep in sync with INGEST_SECRET).
VITE_INGEST_SECRET=dev-secret

# ---- Local-git ingestion ----
# Path to the repo to watch (used by scripts/watch_repo.py)
GIT_REPO_PATH=
GIT_POLL_SECONDS=10

# ---- GenAI gateway (https://genailab.tcs.in) ----
GENAI_GATEWAY_URL=https://genailab.tcs.in
GENAI_API_KEY=
#   demo   -> deterministic offline gateway (default; no credentials needed)
#   http   -> real GenAI Lab gateway via the HTTPX client
#   gemini -> Google Gemini via the google-genai SDK (GEMINI_API_KEY)
LLM_BACKEND=demo
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Model names per PLAN.md
MODEL_TRIAGE=azure/genailab-maas-gpt-4o-mini
MODEL_CORE_REVIEW=genailab-maas-gpt-5.3-codex
MODEL_SECURITY=azure_ai/genailab-maas-DeepSeek-R1
MODEL_SUMMARIZER=gemini-2.5-pro
MODEL_EMBEDDINGS=azure/genailab-maas-text-embedding-3-large

# ---- Gemini backend (LLM_BACKEND=gemini) ----
GEMINI_API_KEY=
MODEL_GEMINI=gemini-3.6-flash

# ---- RAG pipeline ----
# Local (demo/tests) embedder is a deterministic feature-hash vectorizer.
EMBEDDING_DIM=256
# Directory of *.md guideline documents indexed at startup (RAG context).
RAG_GUIDELINES_DIR=data/guidelines

# ---- Review-output publication ----
#   dry_run -> record what would be posted (default; no external calls)
#   none    -> skip publication entirely
PUBLISH_MODE=dry_run

# ---- Webhook adapter (only when deployed / reachable) ----
# GITHUB_WEBHOOK_SECRET=
